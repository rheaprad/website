{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		},
		{
			"files": "src/lib/content/**/*.md",
			"options": {
				"singleQuote": false
			}
		}
	],
	"tailwindStylesheet": "./src/routes/layout.css"
}
